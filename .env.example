# --- Google Sheets ---
SPREADSHEET_ID=your_sheet_id_from_the_url
WORKSHEET_NAME=Sheet1
GOOGLE_CREDENTIALS_FILE=credentials.json
# In CI/Lambda use this instead (paste the whole JSON on one line):
# GOOGLE_CREDENTIALS_JSON=

# --- LinkedIn (get these with: python scripts/get_linkedin_token.py) ---
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=urn:li:person:xxxxxxxx
LINKEDIN_TOKEN_EXPIRES_ON=2026-12-20
# YYYYMM API version header. Check LinkedIn's docs and bump periodically.
LINKEDIN_VERSION=202607

# --- Behaviour ---
TIMEZONE=Asia/Kolkata
MAX_POSTS_PER_RUN=5
# LOG_FILE=pipeline.log

# --- Optional: Gemini rewrite (enables the "AI Rewrite" column) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Only for scripts/get_linkedin_token.py ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
